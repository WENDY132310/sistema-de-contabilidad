# ================================================
# CONFIGURACIÓN DE CONTASYSTEM V2.0
# ================================================

# API Keys para extracción con IA (RECOMENDADO para 95-100% extracción)
# Opción 1: OpenAI (Recomendado)
OPENAI_API_KEY=tu-api-key-aqui

# Opción 2: Anthropic Claude (Alternativa)
ANTHROPIC_API_KEY=tu-api-key-aqui

# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Base de datos
DATABASE_PATH=contasystem.db

# Carpeta de uploads
UPLOAD_FOLDER=uploads

# OCR (Tesseract)
# Si instalaste Tesseract en una ubicación personalizada:
# TESSERACT_CMD=/usr/local/bin/tesseract

# Logging
LOG_LEVEL=INFO
